# scripts/ is dev tooling and stays out of the image, except the free-configs
# seeder, which is meant to be run inside the container. Excluding the children
# and re-including one file works around Docker's rule that a file cannot be
# re-included once its parent directory is excluded (same trick as dashboard/).
scripts/*
!scripts/seed_free_configs.py

# Dev tooling / CI (not used at runtime)
Makefile
.github
.pre-commit-config.yaml
.editorconfig

# Caches and local artifacts
.pytest_cache
.ruff_cache
.uv-cache
.mypy_cache

# Tests config and local databases
pytest.ini
test.db
*.db-journal

# AI / planning scratch output
.AGENT
graphify-out

# Dashboard: upstream excludes the source here because its CI compiles the
# frontend beforehand and drops the result into the context. This fork compiles
# it inside the image instead (the dashboard_src stage in the Dockerfile), so
# the source has to be in the context - excluding it made the very first COPY of
# that stage fail. node_modules is already excluded globally above; the compiled
# output is excluded because a stale local build has no business in the context.
dashboard/build
dashboard/.vite
